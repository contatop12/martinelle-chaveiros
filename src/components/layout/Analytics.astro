---
/**
 * Mensuração. Carregado no <head>.
 * - Consent Mode v2: tudo "denied" por padrão até o visitante aceitar (LGPD).
 * - GTM é carregado somente se PUBLIC_GTM_ID existir; sem GTM, gtag.js direto para GA4/Ads (se houver IDs).
 * - Sem nenhum ID configurado: nenhum script externo é carregado.
 */
import { TRACKING } from '@/config/tracking';

const cfg = {
  gtmId: TRACKING.gtmId,
  ga4Id: TRACKING.ga4Id,
  adsId: TRACKING.adsId,
  adsLabels: TRACKING.adsLabels,
  appendLeadRef: TRACKING.appendLeadRef,
};
const gtagId = !cfg.gtmId ? (cfg.ga4Id ?? cfg.adsId) : null;
---

<script is:inline define:vars={{ cfg }}>
  window.__MC_TRACKING__ = cfg;
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () {
    window.dataLayer.push(arguments);
  };
  var consent = null;
  try {
    consent = localStorage.getItem('mc_consent');
  } catch (e) {}
  var state = consent === 'granted' ? 'granted' : 'denied';
  window.gtag('consent', 'default', {
    ad_storage: state,
    ad_user_data: state,
    ad_personalization: state,
    analytics_storage: state,
    functionality_storage: 'granted',
    security_storage: 'granted',
    wait_for_update: 500,
  });
  window.gtag('set', 'ads_data_redaction', state === 'denied');
  window.gtag('set', 'url_passthrough', true);
</script>

{
  cfg.gtmId && (
    <script is:inline define:vars={{ id: cfg.gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s);
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', id);
    </script>
  )
}

{
  gtagId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gtagId}`} />
      <script is:inline define:vars={{ ga4: cfg.ga4Id, ads: cfg.adsId }}>
        window.gtag('js', new Date());
        if (ga4) window.gtag('config', ga4);
        if (ads) window.gtag('config', ads);
      </script>
    </>
  )
}
