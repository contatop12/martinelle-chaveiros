---
import { Picture } from 'astro:assets';
import logo from '@/assets/images/brand/logo-martinelli-chaves.png';
import Icon from '@/components/ui/Icon.astro';
import { NAV } from '@/data/nav';
import { CONTACT, HOURS } from '@/config/site';
import { waLinkFor, telLink } from '@/lib/contact';

interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
const prefix = isHome ? '' : '/';
---

<a href="#conteudo" class="sr-only-focusable fixed left-3 top-3 z-[100] rounded-lg bg-gold px-4 py-2 font-bold text-ink-950">
  Pular para o conteúdo
</a>

<!-- Linha 1: marca e contato (rola junto com a página) -->
<div class="site-top relative z-40 border-b border-white/[0.06] bg-ink-950">
  <div class="container-x flex h-16 items-center gap-4 lg:h-[76px]">
    <a href={isHome ? '#inicio' : '/'} class="shrink-0" aria-label="Martinelli Chaves — página inicial">
      <Picture src={logo} alt="Martinelli Chaves" formats={['avif', 'webp']} widths={[230, 345, 460]} sizes="(min-width: 1024px) 143px, 115px" width={460} height={193} class="h-12 w-auto lg:h-[60px]" loading="eager" />
    </a>

    <div class="ml-6 hidden flex-col gap-0.5 text-sm lg:flex">
      <p class="flex items-center gap-2.5 text-steel-200">
        <span class="live-dot"></span>
        <span>{HOURS.emergencyShort} pelo WhatsApp e telefone</span>
      </p>
      <p class="hidden pl-[1.15rem] text-xs text-steel-400 xl:block">{HOURS.kioskShort}</p>
    </div>

    <div class="ml-auto flex items-center gap-2 lg:gap-3">
      <a
        href={telLink}
        class="hidden items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold text-steel-200 transition-colors hover:text-gold-light lg:inline-flex"
        data-track="phone_click"
        data-service="geral"
        data-location="header"
      >
        <Icon name="Phone" class="size-4" />
        {CONTACT.phoneDisplay}
      </a>
      <a
        href={waLinkFor('geral')}
        target="_blank"
        rel="noopener"
        class="btn btn-wa btn-sm !min-h-11 !px-3.5 lg:!px-4"
        data-track="whatsapp_click"
        data-service="geral"
        data-location="header"
      >
        <Icon brand="whatsapp" />
        <span>WhatsApp <span class="hidden xs:inline">24h</span></span>
      </a>
      <button
        type="button"
        class="menu-toggle grid size-11 place-items-center rounded-xl border border-white/15 text-white transition-colors hover:border-gold lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
      >
        <Icon name="Menu" class="size-5" />
      </button>
    </div>
  </div>
</div>

<!-- Linha 2: navegação por seções (fixa no topo) -->
<header class="site-nav sticky top-0 z-50 hidden border-b border-white/[0.07] bg-ink-950/85 backdrop-blur-xl lg:block">
  <nav aria-label="Seções da página" class="container-x">
    <ul class="nav-scroll flex h-12 items-center justify-between gap-x-3 overflow-x-auto">
      {
        NAV.map((item) => (
          <li class="shrink-0">
            <a href={`${prefix}#${item.id}`} class="nav-link" data-nav={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- Mobile: barra fixa compacta que aparece ao rolar -->
<div class="mobile-sticky fixed inset-x-0 top-0 z-50 border-b border-white/[0.07] bg-ink-950/90 pt-[env(safe-area-inset-top)] backdrop-blur-xl lg:hidden" data-state="hidden">
  <div class="container-x flex h-16 items-center gap-3">
    <a href={isHome ? '#inicio' : '/'} aria-label="Martinelli Chaves — página inicial" class="shrink-0">
      <Picture src={logo} alt="" formats={['avif', 'webp']} widths={[230, 345, 460]} sizes="105px" width={460} height={193} class="h-11 w-auto" />
    </a>
    <p class="flex items-center gap-2 text-xs font-semibold text-steel-300">
      <span class="live-dot"></span> 24h
    </p>
    <button
      type="button"
      class="menu-toggle ml-auto grid size-11 place-items-center rounded-xl border border-white/15 text-white"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
    >
      <Icon name="Menu" class="size-5" />
    </button>
  </div>
</div>

<!-- Menu mobile: gaveta lateral com fundo escurecido (toque fora fecha) -->
<div class="menu-root fixed inset-0 z-[60] lg:hidden" data-menu-root hidden>
  <div class="menu-backdrop absolute inset-0 bg-ink-950/70 backdrop-blur-[2px]" data-menu-backdrop></div>
  <div
    id="menu-mobile"
    class="menu-panel absolute inset-y-0 right-0 flex w-[min(24rem,88vw)] flex-col border-l border-white/10 bg-ink-950 shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
  >
    <div class="flex shrink-0 items-center justify-between gap-3 border-b border-white/[0.07] px-5 pt-[env(safe-area-inset-top)]">
      <div class="flex h-16 items-center">
        <Picture src={logo} alt="" formats={['avif', 'webp']} widths={[230, 345, 460]} sizes="105px" width={460} height={193} class="h-11 w-auto" />
      </div>
      <button
        type="button"
        class="menu-close grid size-12 place-items-center rounded-full border border-white/25 bg-white/[0.06] text-white transition-colors hover:border-gold hover:text-gold-light"
        aria-label="Fechar menu"
      >
        <Icon name="X" class="size-6" strokeWidth={2.25} />
      </button>
    </div>
    <div class="flex min-h-0 flex-1 flex-col overflow-y-auto overscroll-contain px-5 pt-2 pb-[calc(1.5rem+env(safe-area-inset-bottom))]">
      <nav aria-label="Menu principal">
        <ul class="divide-y divide-white/[0.07]">
          {
            NAV.map((item, i) => (
              <li style={`--i:${i}`} class="menu-item">
                <a
                  href={`${prefix}#${item.id}`}
                  class="flex min-h-[3.25rem] items-center justify-between py-3 font-display text-lg font-semibold [font-stretch:110%]"
                  data-nav={item.id}
                >
                  {item.label}
                  <Icon name="ChevronRight" class="size-5 text-gold" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mt-6 grid gap-3">
        <a
          href={waLinkFor('geral')}
          target="_blank"
          rel="noopener"
          class="btn btn-wa w-full"
          data-track="whatsapp_click"
          data-service="geral"
          data-location="menu_mobile"
        >
          <Icon brand="whatsapp" /> WhatsApp 24h
        </a>
        <a href={telLink} class="btn btn-line w-full" data-track="phone_click" data-service="geral" data-location="menu_mobile">
          <Icon name="Phone" /> Ligar: {CONTACT.phoneDisplay}
        </a>
      </div>
      <p class="mt-5 text-sm text-steel-400">{HOURS.emergency}.</p>
      <p class="mt-1 text-sm text-steel-400">{HOURS.kioskShort}.</p>
    </div>
  </div>
</div>

<style>
  .nav-scroll {
    scrollbar-width: none;
  }
  .nav-scroll::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 3rem;
    padding-inline: 0.15rem;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--color-steel-300);
    white-space: nowrap;
    transition: color 0.2s;
  }
  @media (width >= 80rem) {
    .nav-link {
      font-size: 0.875rem;
    }
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-quart);
  }
  .nav-link:hover {
    color: var(--color-paper);
  }
  .nav-link[aria-current='true'] {
    color: var(--color-gold-light);
  }
  .nav-link[aria-current='true']::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .mobile-sticky {
    transition: transform 0.35s var(--ease-out-quart);
  }
  .mobile-sticky[data-state='hidden'] {
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 0.35s var(--ease-out-quart),
      visibility 0s 0.35s;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-root:not([hidden]) .menu-backdrop {
      animation: fade-in 0.2s ease-out;
    }
    .menu-root:not([hidden]) .menu-panel {
      animation: slide-in 0.28s var(--ease-out-quart);
    }
    .menu-root:not([hidden]) .menu-item {
      animation: item-in 0.4s var(--ease-out-quart) both;
      animation-delay: calc(60ms + var(--i) * 25ms);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateX(12px);
    }
  }
</style>
