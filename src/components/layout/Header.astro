---
import { Image } from 'astro:assets';
import logo from '@/assets/images/brand/logo-martinelli-chaves.png';
import Icon from '@/components/ui/Icon.astro';
import { NAV } from '@/data/nav';
import { CONTACT, HOURS } from '@/config/site';
import { waLinkFor, telLink } from '@/lib/contact';

interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;
const prefix = isHome ? '' : '/';
---

<a href="#conteudo" class="sr-only-focusable fixed left-3 top-3 z-[100] rounded-lg bg-gold px-4 py-2 font-bold text-ink-950">
  Pular para o conteúdo
</a>

<!-- Linha 1: marca e contato (rola junto com a página) -->
<div class="site-top relative z-40 border-b border-white/[0.06] bg-ink-950">
  <div class="container-x flex h-16 items-center gap-4 lg:h-[76px]">
    <a href={isHome ? '#inicio' : '/'} class="shrink-0" aria-label="Martinelli Chaves — página inicial">
      <Image src={logo} alt="Martinelli Chaves" width={220} height={107} class="h-11 w-auto lg:h-[54px]" loading="eager" fetchpriority="high" />
    </a>

    <p class="ml-6 hidden items-center gap-2.5 text-sm text-steel-300 lg:flex">
      <span class="live-dot"></span>
      <span>{HOURS.emergencyShort} pelo WhatsApp e telefone</span>
    </p>

    <div class="ml-auto flex items-center gap-2 lg:gap-3">
      <a
        href={telLink}
        class="hidden items-center gap-2 rounded-xl px-3 py-2 text-sm font-semibold text-steel-200 transition-colors hover:text-gold-light lg:inline-flex"
        data-track="phone_click"
        data-service="geral"
        data-location="header"
      >
        <Icon name="Phone" class="size-4" />
        {CONTACT.phoneDisplay}
      </a>
      <a
        href={waLinkFor('geral')}
        target="_blank"
        rel="noopener"
        class="btn btn-wa btn-sm !min-h-11 !px-3.5 lg:!px-4"
        data-track="whatsapp_click"
        data-service="geral"
        data-location="header"
      >
        <Icon brand="whatsapp" />
        <span>WhatsApp <span class="hidden xs:inline">24h</span></span>
      </a>
      <button
        type="button"
        class="menu-toggle grid size-11 place-items-center rounded-xl border border-white/15 text-white transition-colors hover:border-gold lg:hidden"
        aria-expanded="false"
        aria-controls="menu-mobile"
        aria-label="Abrir menu"
      >
        <Icon name="Menu" class="size-5 icon-open" />
        <Icon name="X" class="size-5 icon-close hidden" />
      </button>
    </div>
  </div>
</div>

<!-- Linha 2: navegação por seções (fixa no topo) -->
<header class="site-nav sticky top-0 z-50 hidden border-b border-white/[0.07] bg-ink-950/85 backdrop-blur-xl lg:block">
  <nav aria-label="Seções da página" class="container-x">
    <ul class="nav-scroll flex h-12 items-center justify-between gap-x-3 overflow-x-auto">
      {
        NAV.map((item) => (
          <li class="shrink-0">
            <a href={`${prefix}#${item.id}`} class="nav-link" data-nav={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<!-- Mobile: barra fixa compacta que aparece ao rolar + menu -->
<div class="mobile-sticky fixed inset-x-0 top-0 z-50 border-b border-white/[0.07] bg-ink-950/90 backdrop-blur-xl lg:hidden" data-state="hidden">
  <div class="container-x flex h-16 items-center gap-3">
    <a href={isHome ? '#inicio' : '/'} aria-label="Martinelli Chaves — página inicial" class="shrink-0">
      <Image src={logo} alt="" width={220} height={107} class="h-10 w-auto" />
    </a>
    <p class="flex items-center gap-2 text-xs font-semibold text-steel-300">
      <span class="live-dot"></span> 24h
    </p>
    <button
      type="button"
      class="menu-toggle ml-auto grid size-11 place-items-center rounded-xl border border-white/15 text-white"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
    >
      <Icon name="Menu" class="size-5 icon-open" />
      <Icon name="X" class="size-5 icon-close hidden" />
    </button>
  </div>
</div>

<div
  id="menu-mobile"
  class="menu-panel fixed inset-0 z-[60] flex flex-col bg-ink-950/97 backdrop-blur-xl lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Menu"
  hidden
>
  <div class="container-x flex h-16 shrink-0 items-center justify-between border-b border-white/[0.07]">
    <Image src={logo} alt="" width={220} height={107} class="h-10 w-auto" />
    <button
      type="button"
      class="menu-close inline-flex h-11 items-center gap-2 rounded-xl border border-white/20 px-3.5 text-sm font-semibold text-white transition-colors hover:border-gold"
    >
      <Icon name="X" class="size-5" /> Fechar
    </button>
  </div>
  <div class="container-x flex min-h-0 flex-1 flex-col overflow-y-auto pb-8 pt-4">
    <nav aria-label="Menu principal">
      <ul class="divide-y divide-white/[0.07] border-y border-white/[0.07]">
        {
          NAV.map((item, i) => (
            <li style={`--i:${i}`} class="menu-item">
              <a
                href={`${prefix}#${item.id}`}
                class="flex items-center justify-between py-4 font-display text-xl font-semibold [font-stretch:110%]"
                data-nav={item.id}
              >
                {item.label}
                <Icon name="ChevronRight" class="size-5 text-gold" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mt-8 grid gap-3">
      <a
        href={waLinkFor('geral')}
        target="_blank"
        rel="noopener"
        class="btn btn-wa w-full"
        data-track="whatsapp_click"
        data-service="geral"
        data-location="menu_mobile"
      >
        <Icon brand="whatsapp" /> WhatsApp 24h
      </a>
      <a href={telLink} class="btn btn-line w-full" data-track="phone_click" data-service="geral" data-location="menu_mobile">
        <Icon name="Phone" /> Ligar: {CONTACT.phoneDisplay}
      </a>
    </div>
    <p class="mt-6 text-sm text-steel-400">{HOURS.emergency}.</p>
  </div>
</div>

<style>
  .nav-scroll {
    scrollbar-width: none;
  }
  .nav-scroll::-webkit-scrollbar {
    display: none;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 3rem;
    padding-inline: 0.15rem;
    font-size: 0.8125rem;
    font-weight: 650;
    color: var(--color-steel-300);
    white-space: nowrap;
    transition: color 0.2s;
  }
  @media (width >= 80rem) {
    .nav-link {
      font-size: 0.875rem;
    }
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-quart);
  }
  .nav-link:hover {
    color: var(--color-paper);
  }
  .nav-link[aria-current='true'] {
    color: var(--color-gold-light);
  }
  .nav-link[aria-current='true']::after,
  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .mobile-sticky {
    transition: transform 0.35s var(--ease-out-quart);
  }
  .mobile-sticky[data-state='hidden'] {
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform 0.35s var(--ease-out-quart),
      visibility 0s 0.35s;
  }

  .menu-panel:not([hidden]) .menu-item {
    animation: menu-in 0.5s var(--ease-out-quart) both;
    animation-delay: calc(var(--i) * 35ms);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
