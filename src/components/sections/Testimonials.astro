---
/**
 * Bloco 14 — Avaliações. Renderiza SOMENTE com avaliações reais cadastradas em src/data/reviews.ts.
 * Sem dados, nada é exibido (nenhum depoimento, nota ou contagem fictícia).
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { REVIEWS, REVIEW_SUMMARY } from '@/data/reviews';
import { LINKS } from '@/config/site';

const show = REVIEWS.length > 0;
---

{
  show && (
    <section id="avaliacoes" class="section surface-white" aria-labelledby="avaliacoes-titulo">
      <div class="container-x">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <SectionHeading id="avaliacoes-titulo" title="O Que Nossos Clientes Dizem">
            {REVIEW_SUMMARY && (
              <span>
                Nota {REVIEW_SUMMARY.rating.toLocaleString('pt-BR')} de 5 no Google, com {REVIEW_SUMMARY.count} avaliações.
              </span>
            )}
          </SectionHeading>
          {LINKS.googleBusiness && (
            <a href={LINKS.googleBusiness} target="_blank" rel="noopener noreferrer" class="btn btn-line shrink-0">
              <Icon brand="google" /> Ver avaliações no Google
            </a>
          )}
        </div>
        <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {REVIEWS.map((r, i) => (
            <li class="rounded-[20px] border border-ink-900/[0.08] bg-mist p-6" data-reveal style={`--i:${i % 3}`}>
              <p class="text-gold-ink" aria-label={`Nota ${r.rating} de 5`}>
                {'★'.repeat(r.rating)}
                <span class="text-steel-300">{'★'.repeat(5 - r.rating)}</span>
              </p>
              <blockquote class="mt-3 text-[0.9375rem] leading-relaxed text-ink-900">“{r.text}”</blockquote>
              <p class="mt-4 text-sm font-semibold text-steel-600">
                {r.author}
                {r.date && <span class="font-normal">, avaliação no Google em {r.date}</span>}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
