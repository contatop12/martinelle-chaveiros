---
/**
 * Avaliações do Google.
 * - Resumo (nota e quantidade) conferido no perfil, exibido como dado estático com data.
 * - Duas faixas de carrossel com os cards de comentário (src/data/reviews.ts) em masonry: cada coluna leva
 *   um card longo ou empilha cards curtos, e as faixas andam em sentidos opostos.
 *   O HTML traz uma cópia de cada card; o script duplica as faixas para o loop só quando há animação.
 *   Com "reduzir movimento" (ou sem JS), as faixas ficam paradas, roláveis e com setas.
 * - Sem marcação de estrelas no Schema (avaliações autodeclaradas não são aceitas pelo Google).
 */
import Icon from '@/components/ui/Icon.astro';
import ReviewCard from '@/components/ui/ReviewCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { REVIEWS, REVIEW_SUMMARY, type Review } from '@/data/reviews';
import { LINKS } from '@/config/site';
import { loadGoogleReviews } from '@/lib/google-reviews';

// Places API (oficial) quando configurada; senão, dados manuais
const google = await loadGoogleReviews();
const s = google ? { rating: google.rating, count: google.count, asOf: null } : REVIEW_SUMMARY;
const reviews = REVIEWS.length ? REVIEWS : (google?.reviews ?? []);
const link = LINKS.googleReviews ?? google?.mapsUri ?? LINKS.googleBusiness;
const show = Boolean(s || reviews.length);

// Masonry: altura do card estimada pelo texto (medida no navegador: ~174px + 25px por linha de ~30 caracteres).
// Cards altos ficam sozinhos na coluna; os curtos são pareados (o maior com o menor que couber em 500px).
const estimate = (r: Review) => (r === reviews[0] ? 416 : 174 + 25 * Math.ceil(r.text.length / 30));
const singles: Review[][] = [];
const pairs: Review[][] = [];
const small = reviews.slice(1).filter((r) => estimate(r) < 330).sort((x, y) => estimate(y) - estimate(x));
reviews.slice(1).forEach((r) => estimate(r) >= 330 && singles.push([r]));
while (small.length) {
  const big = small.shift()!;
  const fit = small.findLastIndex((r) => estimate(big) + 12 + estimate(r) <= 500);
  if (fit === -1) singles.push([big]);
  else pairs.push([big, ...small.splice(fit, 1)]);
}
// Ordem: o card escuro abre a faixa 1; depois blocos "2 colunas de um card + 2 colunas de dois cards",
// para as duas faixas terem a mesma mistura (as colunas alternam entre as faixas)
const byList = (list: Review[][]) => list.sort((x, y) => reviews.indexOf(x[0]) - reviews.indexOf(y[0]));
byList(singles);
byList(pairs);
const columns: Review[][] = [[reviews[0]]];
while (singles.length || pairs.length) {
  columns.push(...singles.splice(0, 2), ...pairs.splice(0, 2));
}

// Duas faixas: colunas intercaladas para misturar cards longos e curtos
const rows = [0, 1].map((n) => columns.filter((_, i) => i % 2 === n));
// a faixa 2 começa com dois cards empilhados (a 1 abre com o card escuro)
rows[1].unshift(...rows[1].splice(rows[1].findIndex((c) => c.length === 2), 1));
---

{
  show && (
    <section id="avaliacoes" class="section surface-white overflow-hidden" aria-labelledby="avaliacoes-titulo" data-rc>
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <SectionHeading id="avaliacoes-titulo" title="A Confiança de Quem Já Contou com a Martinelli">
            Veja a experiência de clientes que escolheram a Martinelli Chaves em Indaiatuba.
          </SectionHeading>

          {s && (
            <div class="rating-card flex items-center gap-5 rounded-[22px] border border-ink-900/[0.08] bg-mist p-5 sm:p-6">
              <span class="grid size-14 shrink-0 place-items-center rounded-full bg-paper shadow-sm">
                <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
                  <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7Z" />
                  <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2a7.2 7.2 0 0 1-6.8-5H1.2v3.1A12 12 0 0 0 12 24Z" />
                  <path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1Z" />
                  <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.2 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8Z" />
                </svg>
              </span>
              <div>
                <p class="flex items-baseline gap-2">
                  <span class="font-display text-4xl font-extrabold leading-none text-ink-900 [font-stretch:115%]">
                    {s.rating.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}
                  </span>
                  <span class="text-xl tracking-[0.12em] text-[#e2a33a]" aria-hidden="true">★★★★★</span>
                  <span class="sr-only">de 5 estrelas</span>
                </p>
                <p class="mt-1 text-sm text-steel-600">
                  {s.count} avaliações no Perfil da Empresa no Google{s.asOf && ` (${s.asOf})`}
                </p>
              </div>
            </div>
          )}
        </div>
      </div>

      {reviews.length > 0 && (
        <div class="mt-12" data-reveal>
          <div class="rc-rows">
            {rows.map((row, r) => (
              <div class="rc-row" data-dir={r ? 'rev' : 'fwd'} style={`--dur:${row.length * 9}s`} data-rc-row>
                <ul class="rc-track" aria-label={r ? 'Avaliações de clientes, faixa 2' : 'Avaliações de clientes, faixa 1'} data-rc-track>
                  {row.map((col) => (
                    <li class="rc-col">
                      {col.map((review) => {
                        const index = reviews.indexOf(review);
                        return <ReviewCard review={review} index={index} tone={index === 0 ? 'dark' : 'light'} reveal={false} />;
                      })}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="container-x mt-10 flex flex-wrap items-center gap-3">
        {link && (
          <a href={link} target="_blank" rel="noopener noreferrer" class="btn btn-line">
            <Icon brand="google" /> Ver Todas as Avaliações no Google
          </a>
        )}
        {reviews.length > 0 && (
          <div class="ml-auto flex items-center gap-2">
            <button type="button" class="rc-btn" data-rc-pause aria-pressed="false" hidden>
              <span data-rc-pause-label>Pausar</span>
            </button>
            <button type="button" class="rc-btn rc-arrow" data-rc-nav="-1" aria-label="Avaliações anteriores">
              <Icon name="ChevronLeft" class="size-5" />
            </button>
            <button type="button" class="rc-btn rc-arrow" data-rc-nav="1" aria-label="Próximas avaliações">
              <Icon name="ChevronRight" class="size-5" />
            </button>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .rc-rows {
    display: grid;
    gap: 0.75rem;
  }
  /* Parado (reduzir movimento ou sem JS): faixa rolável, sem barra, alinhada ao conteúdo */
  .rc-row {
    position: relative; /* contém os textos .sr-only (absolutos) dos cards */
    overflow-x: auto;
    padding-inline: max(1.25rem, calc((100% - 78rem) / 2 + 2rem));
    scroll-padding-inline: max(1.25rem, calc((100% - 78rem) / 2 + 2rem));
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  @media (width >= 48rem) {
    .rc-row {
      padding-inline: max(2rem, calc((100% - 78rem) / 2 + 2rem));
      scroll-padding-inline: max(2rem, calc((100% - 78rem) / 2 + 2rem));
    }
  }
  .rc-row::-webkit-scrollbar {
    display: none;
  }
  .rc-track {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    width: max-content;
  }
  .rc-col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 17.5rem;
    scroll-snap-align: start;
  }
  @media (width >= 40rem) {
    .rc-col {
      width: 20rem;
    }
  }

  /* Em movimento: o script duplica os cards (data-loop) e a faixa anda metade da largura em loop */
  .rc-row[data-loop] {
    overflow: hidden;
    padding-inline: 0;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }
  .rc-row[data-loop] .rc-track {
    padding-right: 0.75rem;
    animation: rc-scroll var(--dur, 240s) linear infinite;
  }
  .rc-row[data-loop][data-dir='rev'] .rc-track {
    animation-direction: reverse;
  }
  .rc-row[data-loop]:hover .rc-track,
  .rc-row[data-loop]:focus-within .rc-track,
  [data-rc][data-paused] .rc-row .rc-track,
  [data-rc][data-offscreen] .rc-row .rc-track {
    animation-play-state: paused;
  }
  @keyframes rc-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .rc-btn {
    display: inline-grid;
    min-height: 2.75rem;
    min-width: 2.75rem;
    place-items: center;
    border: 1px solid rgb(16 18 20 / 0.18);
    border-radius: 999px;
    padding-inline: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-900);
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  .rc-btn:hover {
    border-color: var(--color-ink-900);
    background: rgb(16 18 20 / 0.04);
  }
  .rc-arrow {
    padding-inline: 0;
  }
  /* setas só quando as faixas estão paradas */
  [data-rc][data-looping] .rc-arrow {
    display: none;
  }
</style>
