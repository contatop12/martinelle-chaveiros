---
/**
 * Avaliações do Google.
 * - Resumo (nota e quantidade) conferido no perfil, exibido como dado estático com data.
 * - Faixa animada com os clientes que deram 5 estrelas (nome abreviado), em duas linhas em sentidos opostos.
 * - Cards com comentário: SOMENTE textos fornecidos pelo cliente/agência (src/data/reviews.ts). Sem dados, não aparecem.
 * - Sem marcação de estrelas no Schema (avaliações autodeclaradas não são aceitas pelo Google).
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { FIVE_STAR_REVIEWERS, REVIEWS, REVIEW_SUMMARY } from '@/data/reviews';
import { LINKS } from '@/config/site';
import { loadGoogleReviews } from '@/lib/google-reviews';

// Places API (oficial) quando configurada; senão, dados manuais
const google = await loadGoogleReviews();
const s = google ? { rating: google.rating, count: google.count, asOf: null } : REVIEW_SUMMARY;
const reviews = google?.reviews.length ? google.reviews : REVIEWS;
const link = LINKS.googleReviews ?? google?.mapsUri ?? LINKS.googleBusiness;
const show = Boolean(s || reviews.length);

// Faixa de nomes: duas linhas intercaladas; a cor do avatar varia pela posição
const rows = [0, 1].map((r) => FIVE_STAR_REVIEWERS.filter((_, i) => i % 2 === r));
---

{
  show && (
    <section id="avaliacoes" class="section surface-white" aria-labelledby="avaliacoes-titulo">
      <div class="container-x">
        <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
          <SectionHeading id="avaliacoes-titulo" title="A Confiança de Quem Já Contou com a Martinelli">
            Veja a experiência de clientes que escolheram a Martinelli Chaves em Indaiatuba.
          </SectionHeading>

          {s && (
            <div class="rating-card flex items-center gap-5 rounded-[22px] border border-ink-900/[0.08] bg-mist p-5 sm:p-6">
              <span class="grid size-14 shrink-0 place-items-center rounded-full bg-paper shadow-sm">
                <svg viewBox="0 0 24 24" class="size-7" aria-hidden="true">
                  <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7Z" />
                  <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2a7.2 7.2 0 0 1-6.8-5H1.2v3.1A12 12 0 0 0 12 24Z" />
                  <path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1Z" />
                  <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.2 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8Z" />
                </svg>
              </span>
              <div>
                <p class="flex items-baseline gap-2">
                  <span class="font-display text-4xl font-extrabold leading-none text-ink-900 [font-stretch:115%]">
                    {s.rating.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}
                  </span>
                  <span class="text-xl tracking-[0.12em] text-[#e2a33a]" aria-hidden="true">★★★★★</span>
                  <span class="sr-only">de 5 estrelas</span>
                </p>
                <p class="mt-1 text-sm text-steel-600">
                  {s.count} avaliações no Perfil da Empresa no Google{s.asOf && ` (${s.asOf})`}
                </p>
              </div>
            </div>
          )}
        </div>

        {FIVE_STAR_REVIEWERS.length > 0 && (
          <div class="mt-12" data-reveal>
            <p class="text-[0.9375rem] text-steel-600">
              Alguns dos clientes que avaliaram a Martinelli Chaves com <span class="font-semibold text-ink-900">5 estrelas</span> no Google:
            </p>
            <div class="reviewer-wall mt-5 grid gap-3">
              {rows.map((row, r) => (
                <div class="reviewer-row" data-dir={r ? 'rev' : 'fwd'} style={`--dur:${row.length * 4}s`}>
                  <div class="reviewer-track">
                    {[0, 1].map((copy) => (
                      <ul class="reviewer-list" aria-hidden={copy ? 'true' : undefined} aria-label={copy ? undefined : 'Clientes que avaliaram com 5 estrelas'}>
                        {row.map((name, i) => (
                          <li class="reviewer-chip" data-tone={(i + r) % 3}>
                            <span class="reviewer-avatar" aria-hidden="true">{name.charAt(0)}</span>
                            <span class="font-semibold text-ink-900">{name}</span>
                            <span class="text-[0.8125rem] tracking-[0.08em] text-[#e2a33a]" aria-hidden="true">★★★★★</span>
                            <span class="sr-only">, 5 estrelas</span>
                          </li>
                        ))}
                      </ul>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {reviews.length > 0 && (
          <ul class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {reviews.map((r, i) => (
              <li class="review-card flex flex-col rounded-[20px] border border-ink-900/[0.08] bg-mist p-6" data-reveal style={`--i:${i % 3}`}>
                <p class="text-[#e2a33a]" aria-label={`Nota ${r.rating} de 5`}>
                  {'★'.repeat(r.rating)}
                  <span class="text-steel-300">{'★'.repeat(5 - r.rating)}</span>
                </p>
                <blockquote class="review-text mt-3 text-[0.9375rem] leading-relaxed text-ink-900">“{r.text}”</blockquote>
                <p class="mt-auto flex items-center gap-2.5 pt-5 text-sm text-steel-600">
                  {r.photoUri && <img src={r.photoUri} alt="" width="32" height="32" loading="lazy" referrerpolicy="no-referrer" class="size-8 rounded-full" />}
                  <span>
                    {r.authorUri ? (
                      <a href={r.authorUri} target="_blank" rel="noopener noreferrer nofollow" class="font-semibold text-ink-900 hover:underline">{r.author}</a>
                    ) : (
                      <span class="font-semibold text-ink-900">{r.author}</span>
                    )}
                    {r.date && <span class="block text-xs">{r.date}, no Google</span>}
                  </span>
                </p>
              </li>
            ))}
          </ul>
        )}

        {link && (
          <div class="mt-10">
            <a href={link} target="_blank" rel="noopener noreferrer" class="btn btn-line">
              <Icon brand="google" /> Ver Todas as Avaliações no Google
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  /* Faixa infinita: cada linha tem duas cópias iguais; a trilha anda metade da largura e recomeça */
  .reviewer-row {
    position: relative; /* contém os textos .sr-only (absolutos) quando a animação está desligada */
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  }
  .reviewer-track {
    display: flex;
    width: max-content;
    animation: reviewer-scroll var(--dur, 180s) linear infinite;
  }
  .reviewer-row[data-dir='rev'] .reviewer-track {
    animation-direction: reverse;
  }
  .reviewer-row:hover .reviewer-track {
    animation-play-state: paused;
  }
  .reviewer-list {
    display: flex;
    gap: 0.75rem;
    padding-right: 0.75rem;
  }
  .reviewer-chip {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.625rem;
    border: 1px solid rgb(16 18 20 / 0.08);
    border-radius: 999px;
    background: var(--color-mist);
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .reviewer-avatar {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.875rem;
  }
  .reviewer-chip[data-tone='0'] .reviewer-avatar {
    background: var(--color-ink-900);
    color: var(--color-gold-light);
  }
  .reviewer-chip[data-tone='1'] .reviewer-avatar {
    background: var(--color-gold);
    color: var(--color-ink-950);
  }
  .reviewer-chip[data-tone='2'] .reviewer-avatar {
    background: var(--color-paper);
    color: var(--color-ink-900);
    box-shadow: inset 0 0 0 1px rgb(16 18 20 / 0.12);
  }
  @keyframes reviewer-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  /* Sem animação: linhas roláveis na horizontal, sem a cópia duplicada */
  @media (prefers-reduced-motion: reduce) {
    .reviewer-row {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
      padding-bottom: 0.5rem;
    }
    .reviewer-track {
      animation: none;
    }
    .reviewer-list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
