---
/** Bloco 13 — Nossa estrutura: as duas fotos fornecidas (quiosque + fachada do Sumerbol). */
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { STORE_PHOTOS } from '@/data/photos';
import { ADDRESS, LINKS } from '@/config/site';
---

<section id="nossa-estrutura" class="section surface-graphite" aria-labelledby="estrutura-titulo">
  <div class="container-x">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
      <figure class="lg:col-span-7">
        <div class="photo-frame aspect-[1600/1035] border border-white/[0.08]" data-reveal="wipe">
          <Picture
            src={STORE_PHOTOS.quiosque.src}
            alt={STORE_PHOTOS.quiosque.alt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 56vw, 100vw"
            loading="lazy"
          />
        </div>
        <figcaption class="mt-3 text-sm text-steel-400">Quiosque Martinelli Chaves: chaves, controles, equipamentos e acessórios.</figcaption>
      </figure>

      <div class="lg:col-span-5">
        <SectionHeading id="estrutura-titulo" title="Conheça Nosso Quiosque no Sumerbol">
          Uma estrutura física de verdade, com equipamentos para cópia e programação de chaves, controles e acessórios.
        </SectionHeading>
        <p class="mt-8 flex items-start gap-3 rounded-2xl border border-gold/30 bg-gold/[0.06] p-5 text-white">
          <Icon name="MapPin" class="mt-0.5 size-5 shrink-0 text-gold-light" />
          <span>Estamos no {ADDRESS.venue}, {ADDRESS.unit}, em {ADDRESS.city}.</span>
        </p>
        <a
          href={LINKS.directions}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-gold mt-6"
          data-track="directions_click"
          data-location="secao_estrutura"
        >
          <Icon name="Navigation" /> Como Chegar
        </a>
      </div>
    </div>

    <figure class="mt-12">
      <div class="photo-frame aspect-[16/7] sm:aspect-[1990/609]" data-reveal="wipe">
        <Picture
          src={STORE_PHOTOS.fachada.src}
          alt={STORE_PHOTOS.fachada.alt}
          formats={['avif', 'webp']}
          widths={[640, 1000, 1400, 1990]}
          sizes="(min-width: 1248px) 1184px, 100vw"
          loading="lazy"
        />
      </div>
      <figcaption class="mt-3 text-sm text-steel-400">{ADDRESS.venue}, {ADDRESS.street}, {ADDRESS.district}.</figcaption>
    </figure>
  </div>
</section>
