---
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import BittingLine from '@/components/ui/BittingLine.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import PhoneCta from '@/components/ui/PhoneCta.astro';
import ReviewBadge from '@/components/ui/ReviewBadge.astro';
import { FEATURE_PHOTOS } from '@/data/photos';

const trust = ['Emergências 24h', 'Carros nacionais e importados', 'Chaves codificadas e Smart Keys', 'Quiosque no Sumerbol'];
---

<section id="inicio" class="hero surface-deep relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-glow pointer-events-none absolute" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-8 pt-6 pb-12 md:pt-12 lg:grid-cols-[1.12fr_0.88fr] lg:gap-14 lg:pt-16 lg:pb-24">
    <div>
      <p class="chip hero-in text-steel-200" style="--d:0">
        <span class="live-dot"></span>
        Atendimento emergencial 24h, todos os dias
      </p>

      <BittingLine class="mt-6 mb-4 is-in-load hidden sm:block" />
      <h1 id="hero-title" class="h-display mt-5 text-[clamp(2.25rem,1.1rem+4.6vw,4.5rem)] sm:mt-0">
        Chaveiro Automotivo 24h em Indaiatuba
      </h1>

      <p class="lead mt-5 text-steel-300 sm:mt-6">
        Chaves codificadas, Smart Keys e serviços para carros nacionais, importados e motos. Atendimento emergencial 24 horas em
        Indaiatuba e região.
      </p>

      <div class="hero-in mt-7 hidden flex-wrap gap-3 lg:flex" style="--d:2">
        <WhatsAppCta label="Chamar no WhatsApp" service="geral" location="hero" size="lg" class="flex-auto !gap-2 !px-3 text-[0.9375rem] sm:flex-none sm:!gap-2.5 sm:!px-6 sm:text-[1.0625rem]" />
        <PhoneCta service="geral" location="hero" size="lg" class="flex-auto !gap-2 !px-3 text-[0.9375rem] sm:flex-none sm:!gap-2.5 sm:!px-6 sm:text-[1.0625rem]" />
      </div>

      <ul class="mt-7 grid grid-cols-2 gap-x-4 gap-y-2.5 text-[0.9375rem] text-steel-200 sm:gap-x-6" aria-label="Diferenciais">
        {
          trust.map((t, i) => (
            <li class="hero-in flex items-start gap-2.5" style={`--d:${3 + i * 0.5}`}>
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-gold/15 text-gold-light">
                <Icon name="Check" class="size-3.5" strokeWidth={2.5} />
              </span>
              {t}
            </li>
          ))
        }
      </ul>

      <ReviewBadge class="hero-in mt-7" location="hero" />
    </div>

    <figure class="hero-photo relative mx-auto w-full max-w-[34rem] lg:max-w-none">
      <div class="scan-frame relative overflow-hidden rounded-[22px] border border-white/10 bg-ink-800">
        <Picture
          src={FEATURE_PHOTOS.hero.src}
          alt={FEATURE_PHOTOS.hero.alt}
          formats={['avif', 'webp']}
          widths={[400, 560, 720, 960, 1297]}
          sizes="(min-width: 1024px) 40vw, (min-width: 640px) 34rem, calc(100vw - 40px)"
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/10] w-full object-cover object-[50%_74%] sm:aspect-square lg:aspect-[4/5]"
        />
        <span class="scan-line" aria-hidden="true"></span>
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
      </div>
      <figcaption class="hero-in absolute bottom-3 left-3 right-3 flex items-center gap-3 rounded-2xl border border-white/10 bg-ink-950/80 px-4 py-2.5 text-sm backdrop-blur-md sm:bottom-4 sm:left-4 sm:right-auto sm:py-3" style="--d:5">
        <Icon name="Car" class="size-5 shrink-0 text-gold" />
        <span><strong class="font-semibold text-white">Trabalho real:</strong> <span class="text-steel-300">chaves presenciais para BMW</span></span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 20%, transparent 75%);
  }
  .hero-glow {
    width: 52rem;
    height: 52rem;
    right: -18rem;
    top: -14rem;
    background: radial-gradient(circle, rgb(212 163 74 / 0.16), transparent 62%);
  }

  .corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid var(--color-gold-light);
    filter: drop-shadow(0 0 6px rgb(8 10 12 / 0.6));
  }
  .corner.tl {
    top: 14px;
    left: 14px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
  }
  .corner.tr {
    top: 14px;
    right: 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-right-radius: 8px;
  }
  .corner.bl {
    bottom: 14px;
    left: 14px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-left-radius: 8px;
  }
  .corner.br {
    bottom: 14px;
    right: 14px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-bottom-right-radius: 8px;
  }
  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 38%;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgb(232 196 122 / 0.16) 85%, rgb(232 196 122 / 0.9) 99%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada orquestrada: um único momento no carregamento */
    .hero-in {
      animation: hero-in 0.7s var(--ease-out-quart) both;
      animation-delay: calc(0.1s + var(--d, 0) * 0.06s);
    }
    .hero-photo .corner {
      animation: lock-on 0.7s var(--ease-out-quart) 0.25s both;
    }
    .scan-line {
      animation: scan 1.6s var(--ease-in-out-quart) 0.3s 1 both;
    }
    .is-in-load :global(path) {
      animation: draw 1.4s var(--ease-in-out-quart) 0.2s both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes lock-on {
    from {
      opacity: 0;
      transform: scale(1.9);
    }
  }
  @keyframes scan {
    0% {
      opacity: 0;
      transform: translateY(-100%);
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(265%);
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
