---
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import BittingLine from '@/components/ui/BittingLine.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import PhoneCta from '@/components/ui/PhoneCta.astro';
import { FEATURE_PHOTOS } from '@/data/photos';

const trust = [
  'Atendimento emergencial 24h',
  'Carros nacionais e importados',
  'Atendimento para motocicletas',
  'Quiosque físico no Sumerbol',
  'Atendimento externo em Indaiatuba e região',
  'Residências e comércios',
];
---

<section id="inicio" class="hero surface-deep relative overflow-hidden" aria-labelledby="hero-title">
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="hero-glow pointer-events-none absolute" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-10 pt-8 pb-14 md:pt-12 lg:grid-cols-[1.12fr_0.88fr] lg:gap-14 lg:pt-16 lg:pb-24">
    <div>
      <p class="chip hero-in text-steel-200" style="--d:0">
        <span class="live-dot"></span>
        Atendimento emergencial 24h, todos os dias
      </p>

      <BittingLine class="mt-7 mb-4 is-in-load" />
      <h1 id="hero-title" class="h-display text-[clamp(2.3rem,1.15rem+4.7vw,4.5rem)]">
        Chaveiro Automotivo em Indaiatuba<span class="sr-only"> | </span>
        <span class="hero-sub mt-4 flex items-center gap-4 text-[0.5em] font-semibold text-steel-200 [font-stretch:110%]">
          <span class="h-[1.1em] w-[3px] rounded-full bg-gold" aria-hidden="true"></span>
          Atendimento 24 Horas
        </span>
      </h1>

      <p class="lead mt-6 text-steel-300">
        Chaves codificadas, Smart Keys, cópias, programação e abertura de veículos nacionais e importados. Atendimento
        emergencial 24 horas em Indaiatuba e região.
      </p>

      <div class="hero-in mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" style="--d:2">
        <WhatsAppCta label="Solicitar Atendimento pelo WhatsApp" service="geral" location="hero" size="lg" />
        <PhoneCta service="geral" location="hero" size="lg" />
      </div>

      <ul class="mt-9 grid gap-x-6 gap-y-3 text-[0.9375rem] text-steel-200 sm:grid-cols-2" aria-label="Diferenciais">
        {
          trust.map((t, i) => (
            <li class="hero-in flex items-start gap-3" style={`--d:${3 + i * 0.5}`}>
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-gold/15 text-gold-light">
                <Icon name="Check" class="size-3.5" strokeWidth={2.5} />
              </span>
              {t}
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero-photo relative mx-auto w-full max-w-[34rem] lg:max-w-none">
      <div class="scan-frame relative overflow-hidden rounded-[22px] border border-white/10 bg-ink-800">
        <Picture
          src={FEATURE_PHOTOS.hero.src}
          alt={FEATURE_PHOTOS.hero.alt}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1297]}
          sizes="(min-width: 1024px) 40vw, (min-width: 640px) 34rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full object-cover object-[50%_72%] sm:aspect-[5/5] lg:aspect-[4/5]"
        />
        <span class="scan-line" aria-hidden="true"></span>
        <span class="corner tl" aria-hidden="true"></span>
        <span class="corner tr" aria-hidden="true"></span>
        <span class="corner bl" aria-hidden="true"></span>
        <span class="corner br" aria-hidden="true"></span>
      </div>
      <figcaption class="hero-in absolute bottom-4 left-4 right-4 flex items-center gap-3 rounded-2xl border border-white/10 bg-ink-950/80 px-4 py-3 text-sm backdrop-blur-md sm:right-auto" style="--d:5">
        <Icon name="Car" class="size-5 shrink-0 text-gold" />
        <span><strong class="font-semibold text-white">Trabalho real:</strong> <span class="text-steel-300">chaves presenciais para BMW</span></span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 20%, transparent 75%);
  }
  .hero-glow {
    width: 52rem;
    height: 52rem;
    right: -18rem;
    top: -14rem;
    background: radial-gradient(circle, rgb(212 163 74 / 0.16), transparent 62%);
  }

  .corner {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 0 solid var(--color-gold-light);
    filter: drop-shadow(0 0 6px rgb(8 10 12 / 0.6));
  }
  .corner.tl {
    top: 14px;
    left: 14px;
    border-top-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 8px;
  }
  .corner.tr {
    top: 14px;
    right: 14px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-top-right-radius: 8px;
  }
  .corner.bl {
    bottom: 14px;
    left: 14px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-bottom-left-radius: 8px;
  }
  .corner.br {
    bottom: 14px;
    right: 14px;
    border-bottom-width: 2px;
    border-right-width: 2px;
    border-bottom-right-radius: 8px;
  }
  .scan-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 38%;
    opacity: 0;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, rgb(232 196 122 / 0.16) 85%, rgb(232 196 122 / 0.9) 99%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrada orquestrada: um único momento no carregamento */
    .hero-in {
      animation: hero-in 0.9s var(--ease-out-quart) both;
      animation-delay: calc(0.15s + var(--d, 0) * 0.09s);
    }
    .hero-photo .corner {
      animation: lock-on 0.9s var(--ease-out-quart) 0.35s both;
    }
    .scan-line {
      animation: scan 2.4s var(--ease-in-out-quart) 0.5s 1 both;
    }
    .is-in-load :global(path) {
      animation: draw 1.4s var(--ease-in-out-quart) 0.2s both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes lock-on {
    from {
      opacity: 0;
      transform: scale(1.9);
    }
  }
  @keyframes scan {
    0% {
      opacity: 0;
      transform: translateY(-100%);
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(265%);
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
