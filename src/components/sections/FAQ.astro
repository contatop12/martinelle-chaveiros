---
/** Bloco 15 — Perguntas frequentes. <details> nativo (acessível por teclado) + JSON-LD FAQPage com o mesmo texto visível. */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { FAQ, type FaqItem } from '@/data/faq';
import { faqSchema } from '@/lib/schema';

interface Props {
  items?: FaqItem[];
}
const { items = FAQ } = Astro.props;
---

<section id="perguntas-frequentes" class="section surface-white" aria-labelledby="faq-titulo">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <SectionHeading id="faq-titulo" title="Perguntas Frequentes">
        Respostas diretas sobre chaves, atendimento 24 horas e como funciona cada serviço. Não achou sua dúvida? Pergunte no
        WhatsApp.
      </SectionHeading>
      <div class="mt-8">
        <WhatsAppCta label="Tirar Dúvida no WhatsApp" service="duvida_faq" location="faq" />
      </div>
    </div>

    <div class="faq-list border-t border-ink-900/10">
      {
        items.map((f) => (
          <details class="faq-item border-b border-ink-900/10" name="faq">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left">
              <h3 class="h-card text-[1.0625rem] text-ink-900 sm:text-lg">{f.q}</h3>
              <span class="faq-icon mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-ink-900/15 text-ink-900">
                <Icon name="ChevronDown" class="size-4" />
              </span>
            </summary>
            <div class="faq-body">
              <p class="pb-6 pr-10 text-[0.975rem] leading-relaxed text-steel-600">{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <JsonLd data={faqSchema(items)} />
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-icon {
    transition:
      transform 0.4s var(--ease-out-quart),
      background-color 0.3s,
      color 0.3s,
      border-color 0.3s;
  }
  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    background: var(--color-ink-900);
    border-color: var(--color-ink-900);
    color: var(--color-gold-light);
  }
  summary:hover .faq-icon {
    border-color: var(--color-gold);
  }

  /* Abertura suave onde suportado (progressive enhancement) */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq-list {
        interpolate-size: allow-keywords;
      }
      .faq-item::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size 0.45s var(--ease-out-quart),
          content-visibility 0.45s allow-discrete;
      }
      .faq-item[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
