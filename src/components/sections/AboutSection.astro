---
/**
 * Bloco 12 — Conheça a Martinelli Chaves.
 * Sem nomes, anos de experiência ou história não confirmados: campos em COMPANY ficam ocultos até serem preenchidos.
 */
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { COMPANY, HOURS } from '@/config/site';
import { TEAM_PHOTOS, STORE_PHOTOS } from '@/data/photos';
import type { IconName } from '@/lib/icons';

const pillars: { icon: IconName; title: string; text: string }[] = [
  { icon: 'CarFront', title: 'Especialização', text: 'Chaves codificadas, Smart Keys e chaves presenciais para carros nacionais e importados, além de motos.' },
  { icon: 'Store', title: 'Estrutura física', text: `Quiosque no Sumerbol Supermercados, Piso 2, com estacionamento gratuito. ${HOURS.kioskShort.replace('Quiosque: ', 'Aberto ')}.` },
  { icon: 'Route', title: 'Atendimento externo', text: 'Vamos até onde o veículo ou o imóvel está, em Indaiatuba e região, inclusive em emergências 24h.' },
  { icon: 'ShieldCheck', title: 'Segurança', text: 'Abertura e confecção de chaves somente após a verificação de propriedade ou autorização.' },
];
---

<section id="quem-somos" class="section surface-light overflow-hidden" aria-labelledby="quem-somos-titulo">
  <div class="container-x grid items-center gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div class="relative mx-auto w-full max-w-md pb-10 lg:mx-0">
      <figure class="photo-frame aspect-[3/4] w-[78%] shadow-[0_40px_80px_-40px_rgb(16_18_20/0.5)]" data-reveal="wipe">
        <Picture src={TEAM_PHOTOS.atendimento.src} alt={TEAM_PHOTOS.atendimento.alt} formats={['avif', 'webp']} widths={[335]} sizes="335px" loading="lazy" />
        {COMPANY.owners.names && <figcaption class="absolute inset-x-3 bottom-3 rounded-xl bg-ink-950/80 px-3 py-2 text-sm font-semibold text-white">{COMPANY.owners.names}</figcaption>}
      </figure>
      <figure class="photo-frame absolute right-0 bottom-0 aspect-[4/3] w-[58%] border-[6px] border-mist" data-reveal="wipe" style="--i:2">
        <Picture src={STORE_PHOTOS.quiosque.src} alt={STORE_PHOTOS.quiosque.alt} formats={['avif', 'webp']} widths={[320, 480]} sizes="(min-width: 1024px) 16rem, 58vw" loading="lazy" />
      </figure>
    </div>

    <div>
      <SectionHeading id="quem-somos-titulo" title="Experiência, Tecnologia e Atendimento de Confiança" />
      <div class="mt-6 grid max-w-2xl gap-4 text-[1.0625rem] leading-relaxed text-steel-600">
        <p>
          A Martinelli Chaves é um chaveiro de Indaiatuba com quiosque próprio no Sumerbol Supermercados. O atendimento é feito pela
          própria equipe, no quiosque ou onde o cliente estiver{COMPANY.experience && `, com ${COMPANY.experience}`}.
        </p>
        {COMPANY.owners.story && <p>{COMPANY.owners.story}</p>}
      </div>

      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          pillars.map((f, i) => (
            <li class="rounded-2xl bg-paper p-5" data-reveal style={`--i:${i}`}>
              <span class="flex items-center gap-3">
                <span class="icon-box !size-10 bg-ink-900 text-gold-light">
                  <Icon name={f.icon} class="size-5" />
                </span>
                <h3 class="h-card text-base text-ink-900">{f.title}</h3>
              </span>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-steel-600">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
