---
/** Bloco 16 — Localização e contato. Emergência 24h separada do horário presencial do quiosque. */
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import PhoneCta from '@/components/ui/PhoneCta.astro';
import { ADDRESS, CONTACT, HOURS, LINKS, SERVICE_AREA } from '@/config/site';
import { STORE_PHOTOS } from '@/data/photos';
---

<section id="localizacao" class="section surface-graphite" aria-labelledby="localizacao-titulo">
  <div class="container-x">
    <SectionHeading id="localizacao-titulo" title="Martinelli Chaves em Indaiatuba" />

    <div class="mt-12 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="flex flex-col gap-6">
        <div class="rounded-[22px] border border-white/[0.08] bg-ink-850 p-6 sm:p-8">
          <address class="not-italic">
            <p class="flex gap-4">
              <Icon name="MapPin" class="mt-1 size-5 shrink-0 text-gold" />
              <span class="text-[1.0625rem] leading-relaxed">
                <strong class="font-semibold text-white">{ADDRESS.venue}</strong><br />
                <span class="text-steel-300">
                  {ADDRESS.street}<br />
                  {ADDRESS.unit}<br />
                  {ADDRESS.city}/{ADDRESS.state}
                </span>
              </span>
            </p>
            <p class="mt-5 flex gap-4">
              <Icon name="Phone" class="mt-1 size-5 shrink-0 text-gold" />
              <span class="text-[1.0625rem]">
                <span class="block text-sm text-steel-400">Telefone e WhatsApp</span>
                <a href={`tel:${CONTACT.phoneE164}`} class="font-semibold text-white" data-track="phone_click" data-service="geral" data-location="localizacao_numero">{CONTACT.phoneDisplay}</a>
              </span>
            </p>
          </address>

          <div class="mt-7 grid gap-3">
            <div class="rounded-2xl border border-white/[0.1] bg-white/[0.03] p-4">
              <h3 class="flex items-center gap-2 text-sm font-bold text-white"><Icon name="Clock" class="size-4 text-gold" /> Horário do Quiosque</h3>
              <dl class="mt-2.5 grid gap-1 text-[0.9375rem]">
                {
                  HOURS.kiosk.map((h) => (
                    <div class="flex justify-between gap-3">
                      <dt class="text-steel-300">{h.days}</dt>
                      <dd class:list={['font-semibold', h.spec ? 'text-white' : 'text-steel-400']}>{h.hours}</dd>
                    </div>
                  ))
                }
              </dl>
            </div>
            <div class="rounded-2xl border border-gold/35 bg-gold/[0.07] p-4">
              <h3 class="flex items-center gap-2 text-sm font-bold text-gold-light"><span class="live-dot"></span> Emergências 24h</h3>
              <p class="mt-2.5 text-[0.9375rem] text-white">
                Atendimento externo 24 horas, todos os dias, inclusive domingos e feriados, mediante contato pelo WhatsApp ou telefone.
              </p>
            </div>
          </div>
          <p class="mt-4 text-sm text-steel-400">Atendimento externo em {SERVICE_AREA.label}, {SERVICE_AREA.note.toLowerCase()}.</p>

          <div class="mt-7 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
            <WhatsAppCta label="WhatsApp" service="geral" location="localizacao" size="sm" block />
            <PhoneCta label="Ligar" service="geral" location="localizacao" size="sm" block />
            <a
              href={LINKS.directions}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-gold btn-sm w-full"
              data-track="directions_click"
              data-location="localizacao"
            >
              <Icon name="Navigation" /> Rotas
            </a>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <figure class="photo-frame aspect-[4/3]">
            <Picture src={STORE_PHOTOS.fachada.src} alt={STORE_PHOTOS.fachada.alt} formats={['avif', 'webp']} widths={[320, 520]} sizes="(min-width: 1024px) 20vw, 45vw" loading="lazy" class="object-[75%_50%]" />
          </figure>
          <figure class="photo-frame aspect-[4/3]">
            <Picture src={STORE_PHOTOS.quiosque.src} alt={STORE_PHOTOS.quiosque.alt} formats={['avif', 'webp']} widths={[320, 520]} sizes="(min-width: 1024px) 20vw, 45vw" loading="lazy" />
          </figure>
        </div>
      </div>

      <div
        class="map relative min-h-[22rem] overflow-hidden rounded-[22px] border border-white/[0.08] bg-ink-850 lg:min-h-full"
        data-map-facade
        data-src={LINKS.mapEmbed}
        data-title={`Mapa: ${ADDRESS.venue}, ${ADDRESS.street}, ${ADDRESS.city}`}
      >
        <div class="map-art absolute inset-0" aria-hidden="true"></div>
        <div class="relative flex h-full min-h-[22rem] flex-col items-center justify-center gap-5 p-8 text-center">
          <span class="pin grid size-16 place-items-center rounded-full bg-gold text-ink-950">
            <Icon name="MapPin" class="size-7" />
          </span>
          <p class="max-w-xs text-steel-200">{ADDRESS.venue}, {ADDRESS.street}, {ADDRESS.city}/{ADDRESS.state}</p>
          <button type="button" class="btn btn-line btn-sm">
            <Icon name="MapPin" /> Ver mapa interativo
          </button>
          <p class="max-w-xs text-xs text-steel-400">O mapa do Google é carregado somente após o clique.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .map-art {
    background:
      radial-gradient(circle at 50% 45%, rgb(212 163 74 / 0.16), transparent 40%),
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 40px 40px,
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 40px 40px;
  }
  .map[data-loaded='true'] > :not(iframe) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pin {
      animation: bob 2.8s ease-in-out infinite;
    }
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }
</style>
