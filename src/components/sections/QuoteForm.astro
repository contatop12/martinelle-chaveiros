---
/**
 * Formulário de orçamento rápido (opcional). Monta a mensagem e abre o WhatsApp.
 * Nada é enviado a servidores nem armazenado. Sem nome, telefone ou e-mail: o contato acontece no próprio WhatsApp.
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { CONTACT } from '@/config/site';
import { VERIFIED_BRANDS, BRANDS } from '@/data/brands';

interface Props {
  /** value pré-selecionado (ex.: em páginas de serviço) */
  preset?: string;
}
const { preset = '' } = Astro.props;

const SERVICES = [
  { value: 'chave_automotiva', label: 'Cópia ou chave nova para carro', vehicle: true },
  { value: 'chaves_codificadas', label: 'Chave codificada, Smart Key ou presencial', vehicle: true },
  { value: 'carros_importados', label: 'Chave para carro importado', vehicle: true },
  { value: 'abertura_veiculo', label: 'Abertura de veículo', vehicle: true },
  { value: 'reparo_chave', label: 'Reparo de chave ou controle', vehicle: true },
  { value: 'chaveiro_motos', label: 'Chave para moto', vehicle: true },
  { value: 'eletronica_automotiva', label: 'Eletrônica automotiva', vehicle: true },
  { value: 'chaveiro_residencial', label: 'Chaveiro residencial ou comercial', vehicle: false },
  { value: 'controle_portao', label: 'Controle de portão', vehicle: false },
  { value: 'emergencia_24h', label: 'Emergência 24h', vehicle: false },
];
const presetMap: Record<string, string> = {
  chaveiro_automotivo: 'chave_automotiva',
  emergencia_24h: 'emergencia_24h',
};
const selected = presetMap[preset] ?? preset;
const brandSuggestions = [...new Set([...VERIFIED_BRANDS, ...BRANDS].map((b) => b.name))].sort();
const year = new Date().getFullYear() + 1;
---

<section id="orcamento" class="section surface-deep relative overflow-hidden" aria-labelledby="orcamento-titulo">
  <div class="container-x grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <SectionHeading id="orcamento-titulo" title="Orçamento Rápido pelo WhatsApp">
        Preencha o que souber e toque em enviar: a mensagem chega organizada para a Martinelli responder mais rápido.
      </SectionHeading>
      <ul class="mt-8 grid gap-3 text-[0.9375rem] text-steel-300">
        <li class="flex gap-3"><Icon name="Check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.5} /> Sem cadastro: a conversa acontece no seu WhatsApp.</li>
        <li class="flex gap-3"><Icon name="Check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.5} /> Nenhum dado fica salvo neste site.</li>
        <li class="flex gap-3"><Icon name="Check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.5} /> Prefere falar direto? Use os botões de WhatsApp ou ligação.</li>
      </ul>
    </div>

    <form class="quote-form rounded-[24px] border border-white/[0.08] bg-ink-850 p-5 sm:p-8" data-quote-form data-wa={CONTACT.whatsappNumber} data-location="formulario_orcamento">
      <div class="grid gap-5">
        <div class="field">
          <label for="q-servico">Tipo de serviço</label>
          <div class="relative">
            <select id="q-servico" name="servico" required>
              <option value="" disabled selected={!selected}>Selecione</option>
              {
                SERVICES.map((s) => (
                  <option value={s.value} data-vehicle={s.vehicle ? '1' : '0'} selected={s.value === selected}>
                    {s.label}
                  </option>
                ))
              }
            </select>
            <Icon name="ChevronDown" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-steel-400" />
          </div>
        </div>

        <fieldset class="grid gap-5 sm:grid-cols-[1.1fr_1.1fr_0.8fr]" data-vehicle-fields>
          <legend class="sr-only">Dados do veículo</legend>
          <div class="field">
            <label for="q-marca">Marca <span class="opt">(se for veículo)</span></label>
            <input id="q-marca" name="marca" type="text" list="q-marcas" autocomplete="off" maxlength="40" placeholder="Ex.: Volkswagen" />
            <datalist id="q-marcas">
              {brandSuggestions.map((b) => <option value={b} />)}
            </datalist>
          </div>
          <div class="field">
            <label for="q-modelo">Modelo</label>
            <input id="q-modelo" name="modelo" type="text" autocomplete="off" maxlength="60" placeholder="Ex.: Polo" />
          </div>
          <div class="field">
            <label for="q-ano">Ano</label>
            <input id="q-ano" name="ano" type="text" inputmode="numeric" pattern="(19|20)[0-9]{2}" maxlength="4" autocomplete="off" placeholder={String(year - 1)} title="Ano com 4 dígitos, ex.: 2021" />
          </div>
        </fieldset>

        <div class="field">
          <label for="q-problema">Descrição do problema <span class="opt">(opcional)</span></label>
          <textarea id="q-problema" name="problema" rows="3" maxlength="600" placeholder="Ex.: perdi a única chave, o carro está no estacionamento do mercado"></textarea>
        </div>

        <button type="submit" class="btn btn-wa w-full !min-h-14 text-[1.0625rem]">
          <Icon brand="whatsapp" /> Enviar Solicitação pelo WhatsApp
        </button>
        <p class="text-sm text-gold-light" role="status" data-status hidden></p>
      </div>
    </form>
  </div>
</section>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
  }
  .field label {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--color-steel-200);
  }
  .opt {
    font-weight: 500;
    color: var(--color-steel-400);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: var(--color-ink-950);
    color: var(--color-paper);
    font-size: 1rem;
    appearance: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field ::placeholder {
    color: var(--color-steel-600);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgb(212 163 74 / 0.25);
  }
  .field input:user-invalid,
  .field select:user-invalid {
    border-color: #f08a7e;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
</style>
