---
/**
 * Formulário de orçamento rápido (opcional). Monta a mensagem e abre o WhatsApp.
 * Campos condicionais: carro/moto → marca, modelo, ano; casa/empresa e emergência → bairro ou região.
 * Nada é enviado a servidores nem armazenado.
 */
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { CONTACT } from '@/config/site';
import { BRANDS } from '@/data/brands';

interface Props {
  /** value pré-selecionado (ex.: em páginas de serviço) */
  preset?: string;
}
const { preset = '' } = Astro.props;

type Kind = 'carro' | 'moto' | 'casa' | 'urgente';
const GROUPS: { label: string; options: { value: string; label: string; kind: Kind }[] }[] = [
  {
    label: 'Carro',
    options: [
      { value: 'chave_automotiva', label: 'Cópia ou chave nova para carro', kind: 'carro' },
      { value: 'chaves_codificadas', label: 'Chave codificada, Smart Key ou presencial', kind: 'carro' },
      { value: 'carros_importados', label: 'Chave para carro importado', kind: 'carro' },
      { value: 'abertura_veiculo', label: 'Abertura de veículo', kind: 'carro' },
      { value: 'reparo_chave', label: 'Reparo de chave ou controle', kind: 'carro' },
      { value: 'eletronica_automotiva', label: 'Eletrônica automotiva', kind: 'carro' },
    ],
  },
  { label: 'Moto', options: [{ value: 'chaveiro_motos', label: 'Chave para moto', kind: 'moto' }] },
  {
    label: 'Casa ou empresa',
    options: [
      { value: 'abertura_porta', label: 'Abertura de porta', kind: 'casa' },
      { value: 'copia_chave_residencial', label: 'Cópia de chave comum ou tetra', kind: 'casa' },
      { value: 'fechadura_residencial', label: 'Fechadura ou troca de segredo', kind: 'casa' },
      { value: 'controle_portao', label: 'Controle de portão', kind: 'casa' },
      { value: 'chaveiro_comercial', label: 'Chaveiro para comércio ou empresa', kind: 'casa' },
    ],
  },
  { label: 'Emergência', options: [{ value: 'emergencia_24h', label: 'Emergência 24h', kind: 'urgente' }] },
];

const presetMap: Record<string, string> = {
  chaveiro_automotivo: 'chave_automotiva',
};
const selected = presetMap[preset] ?? preset;
const carBrands = BRANDS.map((b) => b.name).sort((a, b) => a.localeCompare(b, 'pt-BR'));
const motoBrands = ['BMW', 'Ducati', 'Harley-Davidson', 'Honda', 'Kawasaki', 'Royal Enfield', 'Suzuki', 'Triumph', 'Yamaha'];
const year = new Date().getFullYear();
---

<section id="orcamento" class="section surface-deep relative overflow-hidden" aria-labelledby="orcamento-titulo">
  <div class="container-x grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div>
      <SectionHeading id="orcamento-titulo" title="Orçamento Rápido pelo WhatsApp">
        Preencha o que souber e toque em enviar: a mensagem chega organizada para a Martinelli responder mais rápido.
      </SectionHeading>
      <ul class="mt-8 grid gap-3 text-[0.9375rem] text-steel-300">
        <li class="flex gap-3"><Icon name="Check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.5} /> Sem cadastro: a conversa acontece no seu WhatsApp.</li>
        <li class="flex gap-3"><Icon name="Check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.5} /> Nenhum dado fica salvo neste site.</li>
        <li class="flex gap-3"><Icon name="Check" class="mt-1 size-4 shrink-0 text-gold" strokeWidth={2.5} /> Urgente? Use direto os botões de WhatsApp ou ligação.</li>
      </ul>
    </div>

    <form class="quote-form rounded-[24px] border border-white/[0.08] bg-ink-850 p-5 sm:p-8" data-quote-form data-wa={CONTACT.whatsappNumber} data-location="formulario_orcamento">
      <div class="grid gap-5">
        <div class="field">
          <label for="q-servico">Tipo de serviço</label>
          <div class="relative">
            <select id="q-servico" name="servico" required>
              <option value="" disabled selected={!selected}>Selecione</option>
              {
                GROUPS.map((g) => (
                  <optgroup label={g.label}>
                    {g.options.map((o) => (
                      <option value={o.value} data-kind={o.kind} selected={o.value === selected}>
                        {o.label}
                      </option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
            <Icon name="ChevronDown" class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 text-steel-400" />
          </div>
        </div>

        <fieldset class="grid gap-5 sm:grid-cols-[1.1fr_1.1fr_0.8fr]" data-fields="veiculo" hidden>
          <legend class="sr-only">Dados do veículo</legend>
          <div class="field">
            <label for="q-marca">Marca</label>
            <input id="q-marca" name="marca" type="text" list="q-marcas-carro" autocomplete="off" maxlength="40" placeholder="Ex.: BMW" />
            <datalist id="q-marcas-carro">{carBrands.map((b) => <option value={b} />)}</datalist>
            <datalist id="q-marcas-moto">{motoBrands.map((b) => <option value={b} />)}</datalist>
          </div>
          <div class="field">
            <label for="q-modelo">Modelo</label>
            <input id="q-modelo" name="modelo" type="text" autocomplete="off" maxlength="60" placeholder="Ex.: 320i" />
          </div>
          <div class="field">
            <label for="q-ano">Ano</label>
            <input id="q-ano" name="ano" type="text" inputmode="numeric" pattern="(19|20)[0-9]{2}" maxlength="4" autocomplete="off" placeholder={String(year)} title="Ano com 4 dígitos, ex.: 2021" />
          </div>
        </fieldset>

        <div class="field" data-fields="local" hidden>
          <label for="q-bairro">Bairro ou região</label>
          <input id="q-bairro" name="bairro" type="text" autocomplete="off" maxlength="60" placeholder="Ex.: Jardim Pau Preto, Indaiatuba" />
        </div>

        <div class="field">
          <label for="q-problema">Descrição do problema <span class="opt">(opcional)</span></label>
          <textarea id="q-problema" name="problema" rows="3" maxlength="600" placeholder="Conte rapidamente o que aconteceu"></textarea>
        </div>

        <button type="submit" class="btn btn-wa w-full !min-h-14 text-[1.0625rem]">
          <Icon brand="whatsapp" /> Enviar Solicitação pelo WhatsApp
        </button>
        <p class="text-sm text-gold-light" role="status" data-status hidden></p>
      </div>
    </form>
  </div>
</section>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
  }
  .field label {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--color-steel-200);
  }
  .opt {
    font-weight: 500;
    color: var(--color-steel-400);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: var(--color-ink-950);
    color: var(--color-paper);
    font-size: 1rem;
    appearance: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field ::placeholder {
    color: var(--color-steel-600);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgb(212 163 74 / 0.25);
  }
  .field input:user-invalid,
  .field select:user-invalid {
    border-color: #f08a7e;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
</style>
