---
/** Bloco 7 — Chaveiro para motos. Sem fotos reais de motos ainda (ver docs/PENDENCIAS.md): usa ilustração, não foto. */
import SectionHeading from '@/components/ui/SectionHeading.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import { MOTORCYCLE_SERVICES } from '@/data/services';
---

<section id="chaveiro-motos" class="section surface-light overflow-hidden" aria-labelledby="motos-titulo">
  <div class="container-x grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
    <div>
      <SectionHeading id="motos-titulo" title="Chaveiro para Motos em Indaiatuba">
        Cópia, confecção, programação e reparação de chaves de motocicletas, conforme a compatibilidade de cada modelo.
      </SectionHeading>

      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          MOTORCYCLE_SERVICES.map((s, i) => (
            <li class="rounded-2xl border border-ink-900/[0.08] bg-paper p-5" data-reveal style={`--i:${i}`}>
              <h3 class="h-card text-base text-ink-900">{s.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-steel-600">{s.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-steel-600">Informe marca, modelo e ano da moto para confirmarmos se o serviço é possível.</p>
      <div class="mt-8">
        <WhatsAppCta label="Solicitar Atendimento para Moto" messageKey="motos" service="chaveiro_motos" location="secao_motos" />
      </div>
    </div>

    <div class="ignition relative mx-auto aspect-square w-full max-w-[17rem] rounded-[28px] bg-ink-900 p-5 sm:max-w-[26rem] sm:rounded-[32px] sm:p-8" data-observe aria-hidden="true">
      <svg viewBox="0 0 320 320" class="h-full w-full" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="160" cy="160" r="128" stroke="#262b30" stroke-width="2" />
        <circle cx="160" cy="160" r="104" stroke="#363c43" stroke-width="1.5" />
        <circle cx="160" cy="160" r="96" fill="#14171a" />
        <g font-family="Archivo Variable, sans-serif" font-size="15" font-weight="700" letter-spacing="2" text-anchor="middle">
          <text x="160" y="22" fill="#a5abb1" stroke="none" class="lbl-off">OFF</text>
          <text x="262" y="66" fill="#a5abb1" stroke="none" class="lbl-on">ON</text>
          <text x="54" y="66" fill="#5a6168" stroke="none">LOCK</text>
        </g>
        <path d="M160 38v10M243 77l-7 7M77 77l7 7" stroke="#5a6168" stroke-width="2" />
        <circle class="led" cx="262" cy="84" r="4" fill="#363c43" />
        <g class="key">
          <rect x="138" y="70" width="44" height="112" rx="22" stroke="#e8c47a" stroke-width="2.2" fill="#1a1d21" />
          <circle cx="160" cy="92" r="7" stroke="#e8c47a" stroke-width="2" />
          <path d="M148 120h24M148 132h24M148 144h24M148 156h24" stroke="#d4a34a" stroke-width="1.6" opacity=".55" />
          <rect x="154" y="182" width="12" height="44" rx="3" stroke="#e8c47a" stroke-width="2" fill="#14171a" />
        </g>
        <circle cx="160" cy="232" r="6" fill="#262b30" />
      </svg>
    </div>
  </div>
</section>

<style>
  .key {
    transform-origin: 160px 160px;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .ignition .key {
      transform: rotate(0deg);
      transition: transform 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.4s;
    }
    :global(html.js) .ignition.is-in .key {
      transform: rotate(45deg);
    }
    .led,
    .lbl-on,
    .lbl-off {
      transition:
        fill 0.4s 1.1s,
        filter 0.4s 1.1s;
    }
  }
  .ignition.is-in .led {
    fill: var(--color-gold-light);
    filter: drop-shadow(0 0 6px rgb(232 196 122 / 0.9));
  }
  .ignition.is-in .lbl-on {
    fill: var(--color-gold-light);
  }
  .ignition.is-in .lbl-off {
    fill: #5a6168;
  }
  @media (prefers-reduced-motion: reduce) {
    .key {
      transform: rotate(45deg);
    }
  }
</style>
