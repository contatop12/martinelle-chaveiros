---
/** Bloco 7 — Chaveiro para motos, com foto e vídeo reais (Triumph). Vídeo da Honda PCX: pendente (docs/PENDENCIAS.md). */
import { Picture } from 'astro:assets';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import ProofVideo from '@/components/ui/ProofVideo.astro';
import { MOTORCYCLE_SERVICES } from '@/data/services';
import { MOTO_PHOTOS, VIDEOS } from '@/data/photos';
---

<section id="chaveiro-motos" class="section surface-light overflow-hidden" aria-labelledby="motos-titulo">
  <div class="container-x grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <SectionHeading id="motos-titulo" title="Chaveiro para Motos em Indaiatuba">
        Cópias, confecção, programação e soluções para chaves de motocicletas de diferentes marcas e modelos.
      </SectionHeading>

      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          MOTORCYCLE_SERVICES.map((s, i) => (
            <li class="rounded-2xl border border-ink-900/[0.08] bg-paper p-5" data-reveal style={`--i:${i}`}>
              <h3 class="h-card text-base text-ink-900">{s.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-steel-600">{s.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-sm text-steel-600">Informe marca, modelo e ano da moto para confirmarmos se o serviço é possível.</p>
      <div class="mt-8">
        <WhatsAppCta label="Consultar Serviço para Minha Moto" messageKey="motos" service="chaveiro_motos" location="secao_motos" />
      </div>
    </div>

    <figure class="mx-auto w-full max-w-[30rem]">
      <div class="grid grid-cols-2 items-start gap-3 sm:gap-4">
        <div class="photo-frame aspect-[739/1600] border border-ink-900/10 shadow-[0_30px_60px_-30px_rgb(16_18_20/0.45)]" data-reveal="wipe">
          <Picture
            src={MOTO_PHOTOS.triumph.src}
            alt={MOTO_PHOTOS.triumph.alt}
            formats={['avif', 'webp']}
            widths={[260, 400, 600]}
            sizes="(min-width: 1024px) 14rem, 46vw"
            loading="lazy"
          />
        </div>
        <ProofVideo video={VIDEOS.triumph} label="Vídeo: chave de motocicleta Triumph apresentada ao lado da moto" class="max-w-none translate-y-6" />
      </div>
      <figcaption class="mt-10 text-center text-sm font-semibold text-ink-900">Chaves para motocicletas Triumph</figcaption>
    </figure>
  </div>
</section>
