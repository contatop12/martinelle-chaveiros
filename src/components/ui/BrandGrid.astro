---
/**
 * Grade "Trabalhamos com Chaves de Todas as Marcas": todas as marcas com logotipo, na ordem de src/data/brands.ts.
 * O logotipo já traz o nome — o nome fica apenas para leitores de tela.
 * Colunas: 3 → 4 → 6 → 8 (com 24 marcas, todas as linhas ficam completas).
 */
import { GRID_BRANDS } from '@/data/brands';
---

<ul class="brand-grid" aria-label="Marcas atendidas">
  {
    GRID_BRANDS.map((b, i) => (
      <li class="brand-tile" data-reveal style={`--i:${i % 8}`}>
        <span class="brand-logo" style={`--logo:url(${b.logo})`} role="img" aria-label={b.name} />
      </li>
    ))
  }
</ul>

<style>
  /* Logotipos grandes, sem caixas: a marca é o destaque */
  .brand-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem 1rem;
    align-items: center;
  }
  @media (width >= 40rem) {
    .brand-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.25rem 1.5rem;
    }
  }
  @media (width >= 48rem) {
    .brand-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  @media (width >= 80rem) {
    .brand-grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 2.75rem 2rem;
    }
  }
  .brand-tile {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 0.25rem;
    color: var(--color-paper);
    transition: color 0.35s;
  }
  /* brilho dourado discreto atrás do logotipo ao passar o mouse */
  .brand-tile::before {
    content: '';
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, rgb(212 163 74 / 0.22), transparent 62%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .brand-tile:hover {
    color: var(--color-gold-light);
  }
  .brand-tile:hover::before {
    opacity: 1;
  }
  .brand-logo {
    position: relative;
    display: block;
    width: 100%;
    max-width: 5.5rem;
    height: 4.25rem;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transition: transform 0.4s var(--ease-out-quart);
  }
  .brand-tile:hover .brand-logo {
    transform: scale(1.05);
  }
  @media (width >= 40rem) {
    .brand-logo {
      max-width: 7rem;
      height: 5.5rem;
    }
  }
</style>
