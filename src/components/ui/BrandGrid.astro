---
/**
 * Grade "Marcas Atendidas": somente marcas premium verificadas, na ordem de preferência do cliente.
 * O logotipo já traz o nome — o nome fica apenas para leitores de tela.
 */
import { PREMIUM_BRANDS } from '@/data/brands';
---

<ul class="brand-grid" aria-label="Marcas atendidas" style={`--n:${PREMIUM_BRANDS.length}`}>
  {
    PREMIUM_BRANDS.map((b, i) => (
      <li class="brand-tile" data-reveal style={`--i:${i % 4}`}>
        <span class="brand-logo" style={`--logo:url(${b.logo})`} role="img" aria-label={b.name} />
      </li>
    ))
  }
</ul>
<p class="mt-4 text-xs leading-relaxed text-steel-400">
  As marcas mencionadas pertencem aos seus respectivos titulares e são utilizadas exclusivamente para identificar veículos atendidos.
</p>

<style>
  /* Logotipos grandes, sem caixas: a marca é o destaque */
  .brand-grid {
    display: grid;
    grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr));
    gap: 1.5rem 1rem;
    align-items: center;
  }
  @media (width >= 64rem) {
    .brand-grid {
      grid-template-columns: repeat(min(var(--n), 4), minmax(0, 1fr));
      gap: 2.5rem 2rem;
    }
  }
  .brand-tile {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: 0.5rem;
    color: var(--color-paper);
    transition: color 0.35s;
  }
  /* brilho dourado discreto atrás do logotipo ao passar o mouse */
  .brand-tile::before {
    content: '';
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, rgb(212 163 74 / 0.22), transparent 62%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .brand-tile:hover {
    color: var(--color-gold-light);
  }
  .brand-tile:hover::before {
    opacity: 1;
  }
  .brand-logo {
    position: relative;
    display: block;
    width: 100%;
    max-width: 6.5rem;
    height: 5.5rem;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transition: transform 0.4s var(--ease-out-quart);
  }
  .brand-tile:hover .brand-logo {
    transform: scale(1.05);
  }
  @media (width >= 40rem) {
    .brand-logo {
      max-width: 9rem;
      height: 7.5rem;
    }
  }
</style>
