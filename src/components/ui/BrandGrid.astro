---
/**
 * Grade "Marcas Atendidas": somente marcas premium verificadas, na ordem de preferência do cliente.
 * O logotipo já traz o nome — o nome fica apenas para leitores de tela.
 */
import { PREMIUM_BRANDS } from '@/data/brands';
---

<ul class="brand-grid" aria-label="Marcas atendidas" style={`--n:${PREMIUM_BRANDS.length}`}>
  {
    PREMIUM_BRANDS.map((b, i) => (
      <li class="brand-tile" data-reveal style={`--i:${i % 4}`}>
        <span class="brand-logo" style={`--logo:url(${b.logo})`} role="img" aria-label={b.name} />
      </li>
    ))
  }
</ul>
<p class="mt-4 text-xs leading-relaxed text-steel-400">
  As marcas mencionadas pertencem aos seus respectivos titulares e são utilizadas exclusivamente para identificar veículos atendidos.
</p>

<style>
  .brand-grid {
    display: grid;
    grid-template-columns: repeat(min(var(--n), 3), minmax(0, 1fr));
    gap: 0.625rem;
  }
  @media (width >= 64rem) {
    .brand-grid {
      grid-template-columns: repeat(min(var(--n), 4), minmax(0, 1fr));
    }
  }
  .brand-tile {
    position: relative;
    display: grid;
    place-items: center;
    height: 5.5rem;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.035);
    border: 1px solid rgb(255 255 255 / 0.06);
    color: var(--color-steel-200);
    transition:
      color 0.35s,
      background-color 0.35s,
      border-color 0.35s;
  }
  @media (width >= 40rem) {
    .brand-tile {
      height: 6.5rem;
    }
  }
  .brand-tile:hover {
    color: var(--color-gold-light);
    background: rgb(212 163 74 / 0.06);
    border-color: rgb(212 163 74 / 0.25);
  }
  .brand-logo {
    display: block;
    width: 3rem;
    height: 3rem;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  @media (width >= 40rem) {
    .brand-logo {
      width: 3.5rem;
      height: 3.5rem;
    }
  }
</style>
