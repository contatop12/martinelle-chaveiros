---
/** Resumo compacto das avaliações do Google (só aparece se REVIEW_SUMMARY estiver preenchido). */
import Icon from '@/components/ui/Icon.astro';
import { REVIEW_SUMMARY } from '@/data/reviews';
import { loadGoogleReviews } from '@/lib/google-reviews';

interface Props {
  class?: string;
  location: string;
  href?: string;
}
const { class: className = '', location, href = '#avaliacoes' } = Astro.props;
const google = await loadGoogleReviews();
const s = google ? { rating: google.rating, count: google.count } : REVIEW_SUMMARY;
---

{
  s && (
    <a href={href} class:list={['review-badge group inline-flex items-center gap-3 rounded-2xl border border-white/10 bg-white/[0.04] px-3.5 py-2.5 transition-colors hover:border-gold/50', className]} data-location={location}>
      <span class="grid size-9 shrink-0 place-items-center rounded-full bg-white">
        <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7Z" />
          <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2a7.2 7.2 0 0 1-6.8-5H1.2v3.1A12 12 0 0 0 12 24Z" />
          <path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1Z" />
          <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.2 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8Z" />
        </svg>
      </span>
      <span class="leading-tight">
        <span class="flex items-center gap-1.5">
          <span class="font-bold text-white">{s.rating.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</span>
          <span class="tracking-[0.12em] text-gold-light" aria-hidden="true">★★★★★</span>
          <span class="sr-only">de 5 estrelas</span>
        </span>
        <span class="block text-xs text-steel-300 sm:text-sm">{s.count} avaliações no Google</span>
      </span>
      <Icon name="ChevronRight" class="size-4 text-steel-400 transition-transform group-hover:translate-x-0.5" />
    </a>
  )
}
