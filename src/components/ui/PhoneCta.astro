---
/** Botão de ligação. No computador o número fica sempre visível: ligar pelo navegador nem sempre funciona, então a pessoa pode discar do celular. */
import Icon from './Icon.astro';
import { telLink } from '@/lib/contact';
import { CONTACT } from '@/config/site';

interface Props {
  label?: string;
  service: string;
  location: string;
  variant?: 'call' | 'line' | 'gold';
  size?: 'md' | 'sm' | 'lg';
  class?: string;
  block?: boolean;
  showNumber?: boolean;
}

const {
  label = 'Ligar Agora',
  service,
  location,
  variant = 'call',
  size = 'md',
  class: className = '',
  block = false,
  showNumber = false,
} = Astro.props;
---

<a
  href={telLink}
  class:list={[
    'btn',
    { call: 'btn-call', line: 'btn-line', gold: 'btn-gold' }[variant],
    size === 'sm' && 'btn-sm',
    size === 'lg' && 'min-h-14 px-6 text-[1.0625rem]',
    block && 'w-full',
    className,
  ]}
  data-track="phone_click"
  data-service={service}
  data-location={location}
>
  <Icon name="Phone" />
  <span>{label}<span class={showNumber ? 'font-semibold opacity-80' : 'sr-only lg:not-sr-only lg:font-semibold lg:opacity-80'}> {CONTACT.phoneDisplay}</span></span>
</a>
