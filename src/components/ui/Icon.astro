---
/**
 * Ícone via sprite (<use>): cada desenho existe uma única vez no HTML (IconSprite.astro).
 * Lucide = traço; marcas (simple-icons) = preenchimento.
 */
import type { IconName, BrandIconName } from '@/lib/icons';

interface Props {
  name?: IconName;
  brand?: BrandIconName;
  class?: string;
  strokeWidth?: number;
}

const { name, brand, class: className = 'size-5', strokeWidth = 1.75 } = Astro.props;
---

{
  name && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
    >
      <use href={`#i-${name}`} />
    </svg>
  )
}
{
  brand && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <use href={`#b-${brand}`} />
    </svg>
  )
}
