---
/**
 * Card de avaliação do Google: estrelas, etiqueta do serviço citado, texto na íntegra e autor.
 * tone="dark" destaca um card (usado no primeiro da seção de avaliações).
 */
import { TOPIC_LABEL, type Review, type ReviewTopic } from '@/data/reviews';

interface Props {
  review: Review;
  /** Posição na lista: varia a cor do avatar e o atraso da animação de entrada */
  index?: number;
  tone?: 'light' | 'dark';
  /** Serviço da página: a etiqueta mostra este serviço quando a avaliação o cita */
  topic?: ReviewTopic | null;
  reveal?: boolean;
  class?: string;
}

const { review, index = 0, tone = 'light', topic = null, reveal = true, class: className = '' } = Astro.props;
const topics = topic && review.topics?.includes(topic) ? [topic, ...review.topics] : (review.topics ?? []);
const tag = topics.map((t) => TOPIC_LABEL[t]).find(Boolean);
---

<figure class:list={['review-card', className]} data-tone={tone} data-short={review.text.length <= 120 ? '' : undefined} data-reveal={reveal ? '' : undefined} style={reveal ? `--i:${index % 3}` : undefined}>
  <div class="flex items-center justify-between gap-3">
    <p class="review-stars" aria-label={`Nota ${review.rating} de 5`}>
      {'★'.repeat(review.rating)}<span class="opacity-25">{'★'.repeat(5 - review.rating)}</span>
    </p>
    {tag && <span class="review-tag">{tag}</span>}
  </div>

  <blockquote class="review-quote">
    <p>{review.text}</p>
  </blockquote>

  <figcaption class="review-author">
    <span class="review-avatar" data-avatar={index % 3} aria-hidden="true">{review.author.charAt(0)}</span>
    <span class="min-w-0">
      <span class="review-name">{review.author}</span>
      <span class="review-source">
        <svg viewBox="0 0 24 24" class="size-3.5 shrink-0" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7Z" />
          <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2a7.2 7.2 0 0 1-6.8-5H1.2v3.1A12 12 0 0 0 12 24Z" />
          <path fill="#FBBC05" d="M5.2 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4-3.1Z" />
          <path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.2 6.6l4 3.1A7.2 7.2 0 0 1 12 4.8Z" />
        </svg>
        Avaliação no Google
      </span>
    </span>
  </figcaption>
</figure>

<style>
  .review-card {
    position: relative;
    display: flex;
    flex-direction: column;
    break-inside: avoid;
    border: 1px solid rgb(16 18 20 / 0.08);
    border-radius: 22px;
    background: var(--color-mist);
    padding: 1.5rem;
  }
  .review-stars {
    font-size: 1.0625rem;
    letter-spacing: 0.1em;
    color: #e2a33a;
  }
  .review-tag {
    position: relative;
    z-index: 1;
    border: 1px solid rgb(212 163 74 / 0.45);
    border-radius: 999px;
    background: rgb(212 163 74 / 0.1);
    padding: 0.2rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #8a6420;
    white-space: nowrap;
  }
  .review-quote {
    position: relative;
    flex-grow: 1; /* em grade, o autor fica alinhado na base dos cards */
    margin-top: 0.9rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-ink-900);
  }
  .review-author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    border-top: 1px solid rgb(16 18 20 / 0.08);
    padding-top: 1rem;
  }
  .review-avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
  }
  .review-avatar[data-avatar='0'] {
    background: var(--color-ink-900);
    color: var(--color-gold-light);
  }
  .review-avatar[data-avatar='1'] {
    background: var(--color-gold);
    color: var(--color-ink-950);
  }
  .review-avatar[data-avatar='2'] {
    background: var(--color-paper);
    color: var(--color-ink-900);
    box-shadow: inset 0 0 0 1px rgb(16 18 20 / 0.14);
  }
  .review-name {
    display: block;
    font-weight: 700;
    color: var(--color-ink-900);
  }
  .review-source {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.1rem;
    font-size: 0.8125rem;
    color: var(--color-steel-600);
  }

  /* Comentário curto: frase em destaque, maior */
  .review-card[data-short] .review-quote {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.45;
  }
  /* Card em destaque: fundo escuro */
  .review-card[data-tone='dark'] {
    border-color: transparent;
    background: var(--color-ink-900);
    box-shadow: 0 30px 60px -36px rgb(16 18 20 / 0.6);
  }
  .review-card[data-tone='dark'] .review-quote {
    font-size: 1.125rem;
    color: var(--color-paper);
  }
  .review-card[data-tone='dark'] .review-tag {
    color: var(--color-gold-light);
  }
  .review-card[data-tone='dark'] .review-author {
    border-color: rgb(255 255 255 / 0.1);
  }
  .review-card[data-tone='dark'] .review-name {
    color: var(--color-paper);
  }
  .review-card[data-tone='dark'] .review-source {
    color: var(--color-steel-300);
  }
  .review-card[data-tone='dark'] .review-avatar[data-avatar='0'] {
    background: var(--color-gold);
    color: var(--color-ink-950);
  }
</style>
