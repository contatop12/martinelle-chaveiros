---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BittingLine from '@/components/ui/BittingLine.astro';
import WhatsAppCta from '@/components/ui/WhatsAppCta.astro';
import { SERVICE_PAGES } from '@/data/pages';
---

<BaseLayout title="Página não encontrada | Martinelli Chaves" description="A página procurada não existe." path="/404/" noindex>
  <section class="section surface-deep">
    <div class="container-x max-w-3xl">
      <BittingLine class="mb-5" />
      <h1 class="h-display text-[clamp(2rem,1.2rem+3vw,3.25rem)]">Esta página não existe</h1>
      <p class="lead mt-6 text-steel-300">
        O endereço pode ter mudado. Escolha um serviço abaixo ou fale direto com a Martinelli Chaves.
      </p>
      <div class="mt-8">
        <WhatsAppCta label="Falar pelo WhatsApp" service="geral" location="pagina_404" />
      </div>
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        <li><a href="/" class="text-link text-white">Página inicial</a></li>
        {SERVICE_PAGES.map((p) => <li><a href={`/${p.slug}/`} class="text-link text-white">{p.h1}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
