# Copie para .env e preencha SOMENTE com IDs reais das contas da Martinelli Chaves.
# Nenhum ID foi inventado: enquanto estiverem vazios, nenhuma tag de rastreamento é carregada.

# Domínio de produção (canonical, sitemap, Open Graph)
PUBLIC_SITE_URL=https://martinellichaves.com.br

# Google Tag Manager (recomendado: GA4 e Google Ads configurados dentro do GTM)
PUBLIC_GTM_ID=

# Alternativa sem GTM: GA4 e Google Ads direto via gtag.js
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
# Rótulos de conversão do Google Ads (formato AW-XXXXXXXXX/abcDEF123)
PUBLIC_ADS_LABEL_WHATSAPP=
PUBLIC_ADS_LABEL_PHONE=
PUBLIC_ADS_LABEL_FORM=

# Avaliações do Google (Places API New) — usada somente no build, nunca exposta no site.
# Google Cloud Console > APIs e serviços > ativar "Places API (New)" > Credenciais > criar chave
# (restringir a chave à Places API). Sem chave, o site usa as avaliações de src/data/reviews.ts.
GOOGLE_PLACES_API_KEY=
# Opcional: ID do lugar (ex.: ChIJ...). Se vazio, é encontrado pela busca "Martinelli Chaves".
GOOGLE_PLACE_ID=
